# 知鉴 Search 生产环境变量示例（任务 A3）
# 用法：复制为 /etc/zhijian.env，填入真实值，chmod 600，不要提交到 git。

# 知乎 CLI（部署前必须解决 keychain 问题，见 backend/README.md）
ZHIHU_CLI_PATH=/opt/zhihu-cli/zhihu-cli
ZHIHU_ACCESS_SECRET=在此填入去 developer.zhihu.com 生成的 secret

# DeepSeek（可选，缺省走规则抽取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 服务进程
APP_HOST=127.0.0.1
APP_PORT=8000
# 单 worker：多 worker 会多进程并发调知乎撞限流，演示单 worker + 缓存足够
APP_WORKERS=1
